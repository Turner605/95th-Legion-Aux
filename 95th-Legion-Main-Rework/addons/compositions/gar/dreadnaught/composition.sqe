						name="ship_systems_controller";
						init="if (is3DEN) exitWith {};" \n "diag_log ""[95th Ship] Simplified controller starting; transport defaults ONLINE."";" \n "this setVariable [""AUX95_shipConfigV3"",createHashMapFromArray [" \n " [""name"",""95th Dreadnought""],[""announcementRange"",85],[""lightBudget"",4]," \n " [""quartersSound"",""\c-sw-ms\sound\battlestations-no-drill.ogg""]," \n " [""evacSound"",""\c-sw-ms\sound\Base-Evacuate.ogg""]," \n " [""fallbackAlarm"",""\3AS\3AS_Weapons\Roleplay\sounds\RepublicDatapadMeme\starwars\alarm.ogg""]," \n " [""cantinaSound"",""\3AS\3AS_Weapons\Roleplay\sounds\RepublicDatapadMeme\starwars\cantina.ogg""]," \n " [""cantinaDuration"",45.024]" \n "]];" \n "[this] spawn {" \n "    params [""_controller""];" \n "    private _deadline = diag_tickTime + 60;" \n "    waitUntil {" \n "        sleep 0.1;" \n "        (!isNil ""CBA_fnc_addEventHandler"" && {!isNil ""CBA_fnc_serverEvent""} && {!isNil ""CBA_fnc_ownerEvent""})" \n "        || {diag_tickTime > _deadline} || {isNull _controller}" \n "    };" \n "    if (isNull _controller) exitWith {};" \n "    if (isNil ""CBA_fnc_ownerEvent"" || {isNil ""CBA_fnc_serverEvent""} || {isNil ""CBA_fnc_addEventHandler""}) exitWith {diag_log ""[95th Ship] CBA unavailable; ship services were not started.""};" \n "" \n "    private _installRuntime = false;" \n "    isNil {" \n "        if (!(localNamespace getVariable [""AUX95_shipV3_registered"", false]) && {!(localNamespace getVariable [""AUX95_shipV3_registering"", false])}) then {" \n "            localNamespace setVariable [""AUX95_shipV3_registering"", true];" \n "            _installRuntime = true;" \n "        };" \n "        false" \n "    };" \n "    if (_installRuntime) then {" \n "        localNamespace setVariable [""AUX95_shipV3_instances"", []];" \n "        localNamespace setVariable [""AUX95_shipV3_find"", {" \n "            params [""_controller""];" \n "            private _instances = localNamespace getVariable [""AUX95_shipV3_instances"", []];" \n "            private _index = _instances findIf {(_x get ""controller"") isEqualTo _controller};" \n "            if (_index < 0) exitWith {createHashMap};" \n "            _instances # _index" \n "        }];" \n "localNamespace setVariable [""AUX95_shipV3_opsCheck"", {" \n "    params [""_instance"",""_caller"",""_source"",""_operation"",""_argument""];" \n "    if (_operation isEqualTo ""alert"") exitWith {" \n "        if !(_argument in [""normal"",""quarters"",""evacuate""]) exitWith {""Invalid alert condition.""};" \n "        if ((_instance getOrDefault [""nextAnnouncement"",0]) > diag_tickTime) exitWith {""Please wait before changing the alert again.""};" \n "        """"" \n "    };" \n "    if (isNull (getAssignedCuratorLogic _caller)) exitWith {""Ship controls and announcements are restricted to Zeus.""};" \n "    if ((_source getVariable [""AUX95_shipPanelRoleV3"",""lift""]) isNotEqualTo ""command"") exitWith {""Use a main bridge or downstairs briefing command console.""};" \n "    private _key = (_source getVariable [""AUX95_shipNodeV1"",[]]) param [1,""""];" \n "    if (_operation isNotEqualTo ""announce"" && {_key isNotEqualTo ""bridge""}) exitWith {""Ship controls are operated from the bridge. Briefing administration remains available here.""};" \n "    private _valid = switch (_operation) do {" \n "        case ""lighting"": {_argument in [""normal"",""dim"",""tactical"",""off""]};" \n "        case ""hangar"": {_argument in [""hold"",""boarding"",""launch""]};" \n "        case ""announce"": {_argument in [""muster"",""briefing"",""stations"",""medical"",""evacuate"",""allclear"",""nco"",""general""]};" \n "        case ""reset"": {_argument isEqualTo true};" \n "        default {false};" \n "    };" \n "    if (!_valid) exitWith {""Invalid ship setting.""};" \n "    if (_operation isEqualTo ""announce"" && {(_instance getOrDefault [""nextAnnouncement"",0]) > diag_tickTime}) exitWith {""Please wait before another announcement.""};" \n "    """"" \n "}];" \n "localNamespace setVariable [""AUX95_shipV3_opsCommit"", {" \n "    params [""_instance"",""_caller"",""_operation"",""_argument""];" \n "    private _controller = _instance get ""controller"";" \n "    private _ops = _instance get ""ops"";" \n "    private _message = """";" \n "    private _announcement = """";" \n "    private _sound = """";" \n "    private _title = false;" \n "    switch (_operation) do {" \n "        case ""alert"": {" \n "            _ops set [0,_argument];_sound = _argument;_title = true;" \n "            _announcement = switch (_argument) do {case ""quarters"": {""GENERAL QUARTERS\nAll hands report to battle stations.""};case ""evacuate"": {""EVACUATION ALERT\nFollow command instructions and proceed to your assigned departure hangar.""};default {""NORMAL OPERATIONS\nStand down from alert stations.""}};" \n "            _message = ""Alert condition updated. Lift power and bridge security are unchanged."";" \n "        };" \n "        case ""lighting"": {_ops set [1,_argument];_message = ""Supplemental lighting updated.""};" \n "        case ""hangar"": {_ops set [2,_argument];_message = ""Flight-operations board updated.""};" \n "        case ""announce"": {" \n "            _announcement = switch (_argument) do {" \n "                case ""muster"": {""MUSTER\nReport to your assigned squad area in the main briefing room.""};" \n "                case ""briefing"": {""GENERAL BRIEF\nAll personnel report to the main briefing area.""};" \n "                case ""stations"": {""ACTION STATIONS\nReport to your assigned duty station.""};" \n "                case ""medical"": {""MEDICAL ASSISTANCE\nAvailable medical personnel report to the medical room.""};" \n "                case ""evacuate"": {""EVACUATION\nFollow command instructions and proceed to your assigned departure hangar.""};" \n "                case ""allclear"": {""ALL CLEAR\nResume normal duties unless otherwise instructed.""};" \n "                case ""nco"": {""NCO BRIEF\nNCOs report to the bridge.""};" \n "                case ""general"": {""GENERAL BRIEF\nAll personnel report to the main briefing area.""};" \n "                default {""""};" \n "            };" \n "            _title = true;" \n "            if (_argument isEqualTo ""evacuate"") then {_sound = ""evacuate""};" \n "            _message = ""Ship announcement issued."";" \n "        };" \n "        case ""reset"": {" \n "            _ops set [0,""normal""];_ops set [1,""normal""];_ops set [2,""hold""];" \n "            _instance set [""state"",[true,false]];" \n "            _controller setVariable [""AUX95_shipStateV1"",[true,false],true];" \n "            _announcement = ""SHIP SYSTEMS RESTORED\nRegular lifts online. Bridge open. Normal lighting. Flight operations on hold."";" \n "            _sound = ""normal"";_title = true;_message = ""Standard ship systems restored."";" \n "        };" \n "    };" \n "    if (_announcement isNotEqualTo """") then {" \n "        _ops set [3,(_ops # 3)+1];_ops set [4,_announcement];_ops set [5,time];_ops set [6,_sound];_ops set [7,_title];" \n "        _instance set [""nextAnnouncement"",diag_tickTime+8];" \n "    };" \n "    _controller setVariable [""AUX95_shipOpsV3"",+_ops,true];" \n "    _message" \n "}];" \n "localNamespace setVariable [""AUX95_shipV3_escapeText"", {" \n "    params [""_text""];" \n "    private _out = """";" \n "    {_out = _out + (switch (_x) do {case 38:{""&amp;""};case 60:{""&lt;""};case 62:{""&gt;""};default {toString [_x]}})} forEach toArray _text;" \n "    _out" \n "}];" \n "localNamespace setVariable [""AUX95_shipV3_squads"", {" \n "    private _players = allPlayers select {!(_x isKindOf ""HeadlessClient_F"")};" \n "    private _groups = [];" \n "    {_groups pushBackUnique group _x} forEach _players;" \n "    private _lines = [];" \n "    {" \n "        private _grp = _x;" \n "        private _members = _players select {group _x isEqualTo _grp};" \n "        private _label = [format [""%1 — %2"",sid